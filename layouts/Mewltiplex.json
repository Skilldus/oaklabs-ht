{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "toast": "oaklabs-companions",
  "traffic_lights": [
    12,
    16
  ],
  "theme": {
    "light": "Mewltiplex-Clair",
    "dark": "Mewltiplex-Sombre"
  },
  "preview": "layouts/Mewltiplex.png",
  "background": "canvas",
  "ui_font": "Geist",
  "font_weight": 400,
  "terminal_line_height": 1.2,
  "terminal_padding": [
    20,
    20
  ],
  "terminal_opacity": 0,
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 296
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 64
          },
          "window_drag": true,
          "content": {
            "mod": "oaklabs-brand"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "px": 192
              },
              "min": 90,
              "content": {
                "mod": "oaklabs-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "oaklabs-companions",
                "props": {
                  "sidebar": true
                }
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 144
          },
          "content": {
            "mod": "oaklabs-brand",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 64
          },
          "window_drag": true,
          "content": {
            "mod": "oaklabs-tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "background": {
            "gradient": ["#FF4257", "#E11030"],
            "angle": 160
          },
          "padding": 12,
          "gap": 12,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 12,
                  "radius": 14,
                  "shadow": "sm",
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "#14161D"
                  },
                  "focus": {
                    "width": 1,
                    "color": "ring"
                  },
                  "header": {
                    "content": {
                      "mod": "oaklabs-pane"
                    },
                    "height": 64,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 30
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
